# ===== Telegram Bot =====
# Get this from @BotFather
BOT_TOKEN=123456789:ABC-DEF...

# ===== Telethon user session (for locked channels) =====
# Get these from https://my.telegram.org/apps -> API development tools
API_ID=1234567
API_HASH=abcdef1234567890abcdef1234567890

# Phone number with country code, e.g. +15551234567
# Used only for the first `python login.py` run, then session is saved
PHONE=+15551234567

# StringSession — used by Render (no file needed)
# Generate it locally with: python login.py --string
# Then paste the entire printed string here (starts with '1' prefix)
# If SESSION_STRING is set, the file-based session (SESSION_NAME) is ignored.
# SESSION_STRING=1BVtsOH8Bu...

# ===== Destination group (forum / supergroup with topics) =====
# Numeric ID, e.g. -1001234567890
# Get it: add @RawDataBot to the group, it prints the chat_id, then remove it
DESTINATION_GROUP_ID=-1001234567890

# ===== Optional admin whitelist =====
# Comma-separated list of Telegram user IDs allowed to use the bot
# Get your ID from @RawDataBot or @userinfobot
ADMIN_IDS=123456789

# ===== Session file name (Telethon, for local file-based sessions) =====
SESSION_NAME=user_session

# ===== Database path =====
# For local dev: a file path
# For Render free tier: this lives on the ephemeral filesystem and WILL be
#   lost on every restart — that's fine, it only stores pending forwards
#   (short-lived) and topic cache (rebuilt on /refresh)
DB_PATH=forwarder.db

# ===== Deployment mode =====
# polling  — for local dev (default)
# webhook — for Render / any cloud with a public URL (recommended for Render)
MODE=polling

# ===== Webhook settings (only used when MODE=webhook) =====
# The public HTTPS URL of your service. For Render: https://<service-name>.onrender.com
# The bot will register this URL with Telegram on startup.
# WEBHOOK_URL=https://your-service-name.onrender.com

# The port to listen on. Render injects PORT automatically — do not set it
# in Render's dashboard. For local webhook testing, set this to e.g. 8080.
# PORT=8080
